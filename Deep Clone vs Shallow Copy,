//Shallow Copy : A shallow copy creates a new object that copies the top-level properties of the original object. 
//However, for nested objects or arrays, it copies only references to the original nested structures, not the actual nested data.
//Example 
const clonedUser1 = { ...user };  //Copies only first level. Nested objects are STILL shared.

